  {
    "id": "history",
    "type": "mongodb3 in",
    "z": "parking-flow",
    "name": "Read history",
    "service": "_ext_",
    "configNode": "mongo",
    "collection": "parking_snapshots",
    "operation": "find.toArray",
    "x": 630,
    "y": 260,
