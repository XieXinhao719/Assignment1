  {
    "id": "query-build",
    "type": "function",
    "z": "parking-flow",
    "name": "Last 24 hours",
    "func": "msg.payload={collectedAt:{$gte:new Date(Date.now()-86400000).toISOString()}};return msg;",
    "outputs": 1,
