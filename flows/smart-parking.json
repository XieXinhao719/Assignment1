    "group": "parking-group",
    "width": "12",
    "height": "6",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm",
    "interpolate": "linear",
    "nodata": "Collecting data",
    "dot": true,
    "ymin": "",
    "ymax": "",
    "removeOlder": "24",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": [
      "#1f77b4",
      "#ff7f0e",
      "#2ca02c",
      "#d62728",
      "#9467bd",
      "#8c564b"
    ],
    "useOldStyle": false,
    "outputs": 1,
    "wires": [
      []
    ]
  },
  {
    "id": "summary",
    "type": "ui_text",
    "z": "parking-flow",
    "name": "Snapshot summary",
    "group": "parking-group",
    "order": 1,
    "width": "12",
    "height": "2",
    "label": "Latest snapshot",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 1080,
    "y": 280,
    "wires": [
      []
    ]
  },
  {
    "id": "ranking",
    "type": "ui_text",
    "z": "parking-flow",
    "name": "District ranking",
    "group": "parking-group",
    "order": 4,
    "width": "12",
    "height": "6",
    "label": "Most constrained districts (at least 3 reports)",
    "format": "{{{msg.payload}}}",
    "layout": "row-spread",
    "x": 1080,
    "y": 340,
    "wires": [
      []
    ]
  },
  {
    "id": "errors",
    "type": "catch",
    "z": "parking-flow",
    "name": "Flow errors",
    "scope": null,
    "uncaught": false,
    "x": 180,
    "y": 370,
    "wires": [
      [
        "debug"
      ]
    ]
