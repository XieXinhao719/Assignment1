  {
    "id": "overview",
    "type": "ui_template",
    "z": "parking-flow",
    "group": "parking-group",
    "name": "停车洞察总览",
    "order": 1,
    "width": "12",
    "height": "32",
    "format": "<style>\nbody.nr-dashboard-theme { background:#f2f5fa !important; font-family:\"Segoe UI\",\"Microsoft YaHei\",Arial,sans-serif !important; }\nbody.nr-dashboard-theme md-toolbar { background:#102b45 !important; }\nbody.nr-dashboard-theme md-card { box-shadow:none !important; border-radius:16px !important; }\n.parking-ui { color:#183047; padding:18px 22px 28px; background:#f2f5fa; }\n.parking-ui * { box-sizing:border-box; }\n.parking-hero { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:20px; }\n.parking-eyebrow { color:#118b88; font-size:12px; font-weight:800; letter-spacing:.15em; text-transform:uppercase; margin:0 0 7px; }\n.parking-hero h1 { margin:0; color:#102b45; font-size:30px; line-height:1.2; font-weight:800; }\n.parking-subtitle { margin:9px 0 0; color:#617487; font-size:14px; line-height:1.5; }\n.parking-live { flex:none; display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border-radius:99px; color:#08756e; background:#dff7f0; font-size:12px; font-weight:800; }\n.parking-live:before { content:\"\"; width:8px; height:8px; border-radius:50%; background:#11aa7b; box-shadow:0 0 0 4px #b9ebdc; }\n.parking-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:17px; }\n.parking-kpi { padding:18px 19px; border:1px solid #e1e9f0; border-radius:15px; background:#fff; min-height:116px; }\n.parking-kpi small { display:block; color:#6c7e8f; font-size:12px; font-weight:700; }\n.parking-kpi strong { display:block; margin:10px 0 5px; color:#102b45; font-size:28px; line-height:1; font-weight:800; }\n.parking-kpi em { display:block; font-style:normal; color:#718395; font-size:11px; }\n.parking-kpi.urgent strong { color:#d46d3b; }\n.parking-kpi.teal strong { color:#087c78; }\n.parking-columns { display:grid; grid-template-columns:1.15fr .85fr; gap:14px; margin-bottom:14px; }\n.parking-panel { padding:20px; border:1px solid #e1e9f0; border-radius:15px; background:#fff; }\n.parking-panel-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:17px; }\n.parking-panel h2 { margin:0; color:#102b45; font-size:18px; line-height:1.35; font-weight:800; }\n.parking-panel p.note { margin:5px 0 0; color:#728394; font-size:12px; line-height:1.45; }\n.parking-tag { display:inline-block; flex:none; padding:5px 9px; border-radius:6px; background:#edf4f8; color:#3d6178; font-size:11px; font-weight:800; }\n.parking-district { padding:11px 0; border-top:1px solid #edf1f4; }\n.parking-district:first-of-type { border-top:0; }\n.parking-district-line { display:flex; justify-content:space-between; align-items:baseline; gap:8px; font-size:13px; }\n.parking-district-line b { color:#183047; font-weight:700; }\n.parking-district-line span { color:#c5683d; font-size:14px; font-weight:800; }\n.parking-bar { height:8px; margin:7px 0 5px; border-radius:20px; background:#edf2f6; overflow:hidden; }\n.parking-bar i { display:block; height:100%; border-radius:20px; background:linear-gradient(90deg,#efb05f,#dd7347); min-width:2px; }\n.parking-district-meta { color:#748596; font-size:11px; }\n.parking-callout { background:#e8f5f4; border-left:3px solid #138f89; border-radius:8px; padding:13px 14px; color:#245f61; font-size:12px; line-height:1.55; }\n.parking-callout strong { display:block; font-size:13px; margin-bottom:3px; }\n.parking-method { margin-top:18px; display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }\n.parking-method div { border:1px solid #e4ebef; border-radius:9px; padding:10px; background:#fafcfd; }\n.parking-method b { display:block; color:#203a53; font-size:12px; }\n.parking-method span { display:block; margin-top:4px; color:#708294; font-size:11px; line-height:1.35; }\n.parking-list-tools { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }\n.parking-list-tools button { border:1px solid #d7e2e9; border-radius:8px; background:#fff; color:#486174; padding:7px 10px; font:inherit; font-size:12px; font-weight:700; cursor:pointer; }\n.parking-list-tools button.active { background:#102b45; border-color:#102b45; color:#fff; }\n.parking-list-tools input { width:170px; max-width:100%; border:1px solid #d7e2e9; border-radius:8px; padding:7px 10px; color:#173148; font:inherit; font-size:12px; outline:none; }\n.parking-list-tools input:focus { border-color:#15918d; }\n.parking-table { width:100%; border-collapse:collapse; }\n.parking-table th { padding:10px 8px; color:#76899a; font-size:11px; text-align:left; border-bottom:1px solid #e9eef2; }\n.parking-table td { padding:11px 8px; font-size:12px; border-bottom:1px solid #edf1f4; vertical-align:middle; }\n.parking-table tr:last-child td { border-bottom:0; }\n.parking-table .name { color:#183047; font-weight:700; }\n.parking-table .district { color:#738597; }\n.parking-table .number { color:#087c78; font-weight:800; white-space:nowrap; }\n.parking-table .full { color:#c75c43; font-weight:800; }\n.parking-footer { display:flex; justify-content:space-between; gap:12px; margin-top:14px; color:#789; font-size:11px; line-height:1.5; }\n.parking-footer a { color:#087c78; font-weight:700; text-decoration:none; }\n.parking-empty { padding:18px 5px; color:#718395; font-size:12px; }\n@media(max-width:900px) {\n .parking-hero { flex-direction:column; }\n .parking-kpis { grid-template-columns:repeat(2,minmax(0,1fr)); }\n .parking-columns { grid-template-columns:1fr; }\n}\n@media(max-width:540px) {\n .parking-ui { padding:12px 7px 20px; }\n .parking-hero h1 { font-size:24px; }\n .parking-kpis { gap:8px; }\n .parking-kpi { padding:14px; min-height:105px; }\n .parking-kpi strong { font-size:22px; }\n .parking-panel { padding:15px; }\n .parking-method { grid-template-columns:1fr; }\n .parking-list-tools input { width:100%; }\n .parking-table .district { display:none; }\n}\n</style>\n<div class=\"parking-ui\" ng-if=\"msg.payload\" ng-init=\"viewMode='available'\">\n  <header class=\"parking-hero\">\n    <div>\n      <p class=\"parking-eyebrow\">Hong Kong · Smart City Observatory</p>\n      <h1>香港停车供需观察</h1>\n      <p class=\"parking-subtitle\">私家车停车场实时空位 · 按地区对比 · 五分钟采集一次</p>\n    </div>\n    <span class=\"parking-live\">数据采集中</span>\n  </header>\n\n  <div class=\"parking-kpis\">\n    <div class=\"parking-kpi\"><small>有报告的停车场</small><strong>{{msg.payload.reported | number}}</strong><em>不是全港停车场总数</em></div>\n    <div class=\"parking-kpi urgent\"><small>报告已满</small><strong>{{msg.payload.full | number}}</strong><em>占有报告停车场 {{msg.payload.fullPct}}%</em></div>\n    <div class=\"parking-kpi teal\"><small>精确报告的可用车位</small><strong>{{msg.payload.spacesAvailable | number}}</strong><em>仅汇总 A 类精确数量</em></div>\n    <div class=\"parking-kpi\"><small>近 24 小时样本</small><strong>{{msg.payload.snapshotCount | number}}</strong><em>每次采集形成一个快照</em></div>\n  </div>\n\n  <div class=\"parking-columns\">\n    <section class=\"parking-panel\">\n      <div class=\"parking-panel-header\">\n        <div><h2>分区停车压力</h2><p class=\"note\">按“有报告停车场中已满的比例”排序；至少 3 个报告才纳入</p></div>\n        <span class=\"parking-tag\">{{msg.payload.districtCount}} 个地区</span>\n      </div>\n      <div class=\"parking-district\" ng-repeat=\"d in msg.payload.districts | limitTo:8 track by d.district\">\n        <div class=\"parking-district-line\"><b>{{$index+1}}. {{d.district}}</b><span>{{d.fullPct}}% 已满</span></div>\n        <div class=\"parking-bar\"><i ng-style=\"{'width':d.fullPct+'%'}\"></i></div>\n        <div class=\"parking-district-meta\">{{d.full}} / {{d.reported}} 个已满 · {{d.spacesAvailable | number}} 个精确空位 · {{d.exactCount}} 个 A 类报告</div>\n      </div>\n      <div class=\"parking-empty\" ng-if=\"!msg.payload.districts.length\">等待足够的分区数据。</div>\n    </section>\n\n    <section class=\"parking-panel\">\n      <div class=\"parking-panel-header\"><div><h2>如何解读</h2><p class=\"note\">把比例、数量和样本覆盖一起看</p></div></div>\n      <div class=\"parking-callout\">\n        <strong>{{msg.payload.insightTitle}}</strong>\n        {{msg.payload.insightText}}\n      </div>\n      <div class=\"parking-method\">\n        <div><b>A · 精确空位</b><span>{{msg.payload.exactCount}} 个停车场提供数字，可用于空位总和。</span></div>\n        <div><b>B · 满 / 未满</b><span>{{msg.payload.binaryCount}} 个停车场仅提供状态，不计入空位总和。</span></div>\n        <div><b>覆盖范围</b><span>{{msg.payload.metadataTotal}} 个目录停车场；{{msg.payload.notReporting}} 个未纳入本次有效报告。</span></div>\n      </div>\n      <p class=\"note\" style=\"margin-top:15px\">采集时间：{{msg.payload.updatedLocal}}（香港时间）。运营商更新时间可能不同；这不是车位占用率。</p>\n    </section>\n  </div>\n\n  <section class=\"parking-panel\">\n    <div class=\"parking-panel-header\">\n      <div><h2>停车场明细</h2><p class=\"note\">按精确空位数排序，或查看已满停车场；可按名称与地区搜索</p></div>\n      <div class=\"parking-list-tools\">\n        <button type=\"button\" ng-class=\"{'active':viewMode==='available'}\" ng-click=\"viewMode='available'\">较多空位</button>\n        <button type=\"button\" ng-class=\"{'active':viewMode==='full'}\" ng-click=\"viewMode='full'\">已满</button>\n        <input type=\"search\" aria-label=\"搜索停车场\" placeholder=\"搜索名称或地区\" ng-model=\"parkSearch\">\n      </div>\n    </div>\n    <table class=\"parking-table\">\n      <thead><tr><th>停车场</th><th class=\"district\">地区</th><th>状态 / 空位</th></tr></thead>\n      <tbody>\n        <tr ng-repeat=\"p in (viewMode==='full' ? msg.payload.fullParks : msg.payload.availableParks) | filter:parkSearch | limitTo:12 track by p.id\">\n          <td class=\"name\">{{p.name}}</td><td class=\"district\">{{p.district}}</td>\n          <td ng-if=\"viewMode==='available'\" class=\"number\">{{p.available | number}} 个</td>\n          <td ng-if=\"viewMode==='full'\" class=\"full\">已满</td>\n        </tr>\n      </tbody>\n    </table>\n    <div class=\"parking-empty\" ng-if=\"viewMode==='full' && !msg.payload.fullParks.length\">本次采集没有已满停车场。</div>\n    <div class=\"parking-footer\"><span>表格最多显示 12 项。B 类仅有状态，无法按空位数量排序。</span><a href=\"https://data.gov.hk/en-data/dataset/hk-dpo-datagovhk1-carpark-info-vacancy\" target=\"_blank\" rel=\"noopener\">数据来源 · data.gov.hk ↗</a></div>\n  </section>\n</div>",
